        "\n",
        "# Implementation of Expectation-Maximization Algorithm\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.mixture import GaussianMixture\n",
        "\n",
        "# Create sample dataset\n",
        "X = np.array([\n",
        "    [1, 2], [1.5, 1.8], [2, 2.5],\n",
        "    [3, 3], [3.5, 2.8], [4, 3.5],\n",
        "    [8, 8], [8.5, 8.5], [9, 8],\n",
        "    [9.5, 9], [10, 8.5], [10.5, 9.5]\n",
        "])\n",
        "\n",
        "# Initialize Gaussian Mixture Model\n",
        "gmm = GaussianMixture(\n",
        "    n_components=2,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "# Train the model using EM algorithm\n",
        "gmm.fit(X)\n",
        "\n",
        "# Predict clusters\n",
        "labels = gmm.predict(X)\n",
        "\n",
        "# Display results\n",
        "print(\"Expectation-Maximization Algorithm\")\n",
        "print(\"\\nCluster Labels:\")\n",
        "print(labels)\n",
        "\n",
        "print(\"\\nCluster Means:\")\n",
        "print(gmm.means_)\n",
        "\n",
        "print(\"\\nCluster Covariances:\")\n",
        "print(gmm.covariances_)\n",
        "\n",
        "print(\"\\nModel Weights:\")\n",
        "print(gmm.weights_)\n",
        "\n",
        "print(\"\\nLog Likelihood:\")\n",
        "print(gmm.score(X))\n",
        "\n",
        "# Visualize clusters\n",
        "plt.scatter(\n",
        "    X[:, 0], X[:, 1],\n",
        "    c=labels, cmap='viridis',\n",
        "    s=100\n",
        ")\n",
        "\n",
        "plt.scatter(\n",
        "    gmm.means_[:, 0],\n",
        "    gmm.means_[:, 1],\n",
        "    color='red', marker='X',\n",
        "    s=200, label='Cluster Centers'\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Feature 1\")\n",
        "plt.ylabel(\"Feature 2\")\n",
        "plt.title(\"Expectation-Maximization Clustering\")\n",
        "plt.legend()\n",
        "plt.show()\n"
      ]
